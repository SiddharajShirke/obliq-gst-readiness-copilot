NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase-backed local and all deployed environments must remain false.
NEXT_PUBLIC_DEMO_MODE=false
# Hosted builds must replace the localhost values above during `next build`.
# The browser now fails closed if a hosted page is compiled with a local/private API.
