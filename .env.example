# -----------------------------------------------------------------------------
# OBLIQ GST Readiness Copilot — prototype environment
# Copy to .env. Never commit real credentials.
# -----------------------------------------------------------------------------

# Application
APP_NAME="OBLIQ GST Readiness Copilot"
APP_ENV=development
APP_DEBUG=true
DEMO_MODE=true
USE_IN_MEMORY_DB=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Frontend (also copy these to frontend/.env.local for direct npm dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO_MODE=true

# Supabase — required when USE_IN_MEMORY_DB=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
DATABASE_URL=
SUPABASE_DOCUMENTS_BUCKET=gst-documents
SUPABASE_KNOWLEDGE_BUCKET=knowledge-documents
SUPABASE_EXPORTS_BUCKET=exports

# AI mode and provider routing
AI_MODE=mock
TEXT_LLM_PROVIDER=groq
VISION_LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini

# Embeddings and RAG
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
RAG_VECTOR_TOP_K=12
RAG_FINAL_TOP_K=5
RAG_MIN_SIMILARITY=0.45
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140

# OCR
OCR_ENABLED=true
TESSERACT_CMD=

# Uploads
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,csv,xlsx,json
UPLOAD_LINK_TTL_HOURS=72
UPLOAD_TOKEN_PEPPER=replace-with-a-random-local-value
LOCAL_UPLOAD_DIR=.runtime/uploads
LOCAL_EXPORT_DIR=.runtime/exports

# WhatsApp
WHATSAPP_PROVIDER=mock
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=obliq-local-verify-token
META_GRAPH_API_VERSION=v26.0
META_TEST_RECIPIENT_NUMBER=
META_DOCUMENT_REQUEST_TEMPLATE=gst_document_request_v1
META_REMINDER_TEMPLATE=gst_document_reminder_v1
ALLOW_LOCAL_CREDENTIAL_SETUP=false
LOCAL_META_CREDENTIALS_FILE=.runtime/meta_credentials.json
PUBLIC_WEBHOOK_BASE_URL=

# ngrok (optional helper only)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Synthetic demo accounts
DEMO_ADMIN_EMAIL=demo.admin@obliq.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_PREPARER_EMAIL=demo.preparer@obliq.local
DEMO_PREPARER_PASSWORD=ChangeMe123!
DEMO_REVIEWER_EMAIL=demo.reviewer@obliq.local
DEMO_REVIEWER_PASSWORD=ChangeMe123!
DEMO_RESET_ON_START=false
DEMO_SEED_DATA=true
