# -----------------------------------------------------------------------------
# OBLIQ GST Readiness Copilot — prototype environment
# Copy to .env. Never commit real credentials.
# -----------------------------------------------------------------------------

# Application — local defaults. Render overrides the production values.
APP_NAME="OBLIQ GST Readiness Copilot"
APP_ENV=development
APP_DEBUG=true
DEMO_MODE=true
USE_IN_MEMORY_DB=true
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Frontend (also copy these to frontend/.env.local for direct npm dev)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Keep true only for the intentionally Supabase-unconfigured MemoryStore demo.
# Set false whenever USE_IN_MEMORY_DB=false.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase — required when USE_IN_MEMORY_DB=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=
DATABASE_URL=
SUPABASE_DOCUMENTS_BUCKET=gst-documents
SUPABASE_KNOWLEDGE_BUCKET=knowledge-documents
SUPABASE_EXPORTS_BUCKET=exports

# Phase 3/4 AI routing. Use mock only in automated tests.
AI_MODE=live
TEXT_LLM_PROVIDER=groq
VISION_LLM_PROVIDER=nvidia
LLM_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_HEAVY_MODEL=openai/gpt-oss-120b
GROQ_RAG_MODEL=openai/gpt-oss-120b
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_SMALL_MODEL=meta/llama-3.1-8b-instruct
# Optional. Set only to a verified NVIDIA model that accepts image inputs.
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct

# Embeddings and RAG
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
# Keep false on memory-constrained web instances; embeddings load on first RAG use.
EMBEDDING_WARMUP_ENABLED=false
RAG_VECTOR_TOP_K=12
RAG_FINAL_TOP_K=5
RAG_MIN_SIMILARITY=0.45
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=140
RAG_GENERATION_TIMEOUT_SECONDS=1.5
RAG_MAX_OUTPUT_TOKENS=800
# Serialize memory-heavy OCR/document/RAG work on small single-instance deployments.
HEAVY_PROCESSING_CONCURRENCY=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# OCR. Leave TESSERACT_CMD empty in Docker; the packaged binary is resolved from PATH.
OCR_ENABLED=true
TESSERACT_CMD=

# Uploads
MAX_UPLOAD_MB=20
BULK_UPLOAD_MAX_FILES=20
BULK_UPLOAD_MAX_TOTAL_MB=100
ALLOWED_UPLOAD_EXTENSIONS=pdf,png,jpg,jpeg,csv,xlsx,docx,json
UPLOAD_LINK_TTL_HOURS=72
UPLOAD_TOKEN_PEPPER=replace-with-a-random-local-value
# MemoryStore-only local paths. Supabase production does not persist here.
LOCAL_UPLOAD_DIR=.runtime/uploads
LOCAL_EXPORT_DIR=.runtime/exports

# Vonage Messages API WhatsApp Sandbox (backend-only secrets)
WHATSAPP_PROVIDER=vonage
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_SIGNATURE_SECRET=
VONAGE_WHATSAPP_FROM=
VONAGE_SANDBOX_JOIN_MESSAGE=
VONAGE_MESSAGES_BASE_URL=https://messages-sandbox.nexmo.com
PUBLIC_BASE_URL=https://your-public-backend-url
WHATSAPP_DEMO_TOKEN_EXPIRY_MINUTES=20
WHATSAPP_DEMO_SESSION_EXPIRY_MINUTES=120
WHATSAPP_DEMO_DATA_RETENTION_HOURS=24
WHATSAPP_DEMO_TOKEN_PEPPER=
WHATSAPP_PHONE_HASH_PEPPER=
WHATSAPP_PHONE_ENCRYPTION_KEY=

# ngrok (optional local Vonage helper only; never use as a production URL)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Synthetic demo accounts
DEMO_ADMIN_EMAIL=demo.admin@obliq.local
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_PREPARER_EMAIL=demo.preparer@obliq.local
DEMO_PREPARER_PASSWORD=ChangeMe123!
DEMO_REVIEWER_EMAIL=demo.reviewer@obliq.local
DEMO_REVIEWER_PASSWORD=ChangeMe123!
DEMO_RESET_ON_START=false
DEMO_SEED_DATA=true
